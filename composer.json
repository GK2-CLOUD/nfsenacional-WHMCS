{
    "name": "gk2/whmcs-nfsenacional",
    "description": "WHMCS Addon para NFS-e Nacional (ADN)",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.0",
        "robrichards/xmlseclibs": "^3.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "GK2\\NfseNacional\\": "src/NfseNacional/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GK2\\NfseNacional\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=256M",
        "cs-check": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "security-check": "composer audit",
        "check": [
            "@phpstan",
            "@cs-check",
            "@security-check",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "GK2",
            "email": "webmaster@gk2.com.br"
        }
    ]
}
